# Copie este arquivo para .env e cole sua chave da OpenWeb Ninja.
#
#   cp .env.example .env      <- copie, não renomeie: o exemplo precisa ficar
#                                no repositório para o próximo que clonar
#
# Sem o prefixo VITE_ de propósito: o Vite só injeta no bundle do navegador as
# variáveis que começam com VITE_. Esta fica apenas no processo Node do dev
# server, que é quem monta o header x-api-key no proxy — o browser nunca a vê.
#
# O .env está no .gitignore. Não o commite, e não renomeie esta variável para
# VITE_JSEARCH_API_KEY: isso publicaria a chave em dist/assets/*.js.
JSEARCH_API_KEY=cole_sua_chave_aqui

# Chave da Anthropic, para a Avaliação IA. Mesmo motivo do sem-VITE_ acima:
# esta variável fica no processo Node do dev server, que monta o header
# x-api-key do proxy. Renomear para VITE_ANTHROPIC_API_KEY publicaria a chave
# em dist/assets/*.js — e esta, diferente da JSearch, não tem teto de uso.
ANTHROPIC_API_KEY=cole_sua_chave_aqui
